{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Season",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string"
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ign", "url", "color", "videos"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "ign": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "url", "date"],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
